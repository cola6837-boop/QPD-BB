name: Compilar APK Elantra Premium 2
on:
  workflow_dispatch:
  push:
    branches: [main, principal]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.10.2'
      - name: Preparar proyecto
        shell: bash
        run: |
          set -euo pipefail
          if [ -f settings.gradle ]; then
            PROJECT_DIR="$PWD"
          else
            ZIP=$(find . -maxdepth 1 -type f -iname 'Elantra_Premium_V2_Android_CORREGIDO.zip' -print -quit)
            if [ -z "$ZIP" ]; then
              echo 'No se encuentra Elantra_Premium_V2_Android_CORREGIDO.zip en la raiz'
              exit 1
            fi
            mkdir -p extracted
            unzip -q "$ZIP" -d extracted
            PROJECT_DIR="$PWD/extracted/ElantraPremiumV2"
          fi
          test -f "$PROJECT_DIR/settings.gradle"
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
      - name: Compilar APK
        shell: bash
        run: |
          cd "$PROJECT_DIR"
          gradle :app:assembleDebug --no-daemon --stacktrace
      - name: Publicar APK
        uses: actions/upload-artifact@v4
        with:
          name: Elantra-Premium-V2-APK
          path: |
            extracted/**/app/build/outputs/apk/debug/*.apk
            app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
